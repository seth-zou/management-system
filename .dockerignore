__pycache__/
*.py[cod]
*.pyo
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# IDE / Editor
.idea/
.vscode/
.vs/
.settings/
.project
.pydevproject
.ropeproject
.DS_Store

# Build artifacts
build/
dist/
*.egg
*.so

# Test / coverage
htmlcov/
.tox/
.coverage
.cache
coverage.xml
