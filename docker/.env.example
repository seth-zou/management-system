# =============================================================================
# Environment variables for docker-compose deployment
# =============================================================================
# Copy this file to .env and customize as needed:
#   cp docker/.env.example .env
# =============================================================================

# Master password for Odoo database management (CHANGE THIS in production!)
ADMIN_PASSWD=admin

# Database credentials
DB_USER=odoo
DB_PASSWORD=odoo
DB_NAME=postgres

# Odoo ports (host mapping)
ODOO_PORT=8069
ODOO_LONGPOLLING_PORT=8072
